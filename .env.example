# .env.example — copy to .env.local and fill in real values before running against live services.
# Nothing here needs to be real to build, lint, or run the test suite.

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/placement_tracker"

# --- Auth (NextAuth v4 + Google OAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# --- Admin bootstrap ---
# Seeded as the one automatic admin on first sign-in (idempotent — safe to
# leave as-is across restarts/redeploys). Further admins are added
# self-service from /admin/manage-admins once this account signs in once.
INITIAL_ADMIN_EMAIL="gargstrixy@gmail.com"

# --- Gmail ingestion (same Google Cloud project as OAuth) ---
GMAIL_REFRESH_TOKEN="replace-with-refresh-token-for-the-inbox-being-watched"
GMAIL_LABEL_ID="replace-with-the-Placement-Tracker-label-id"
GMAIL_PUBSUB_TOPIC="projects/your-project/topics/placement-tracker"
GMAIL_PUBSUB_VERIFICATION_TOKEN="replace-with-a-random-shared-secret"

# --- Extraction LLMs ---
GOOGLE_GENERATIVE_AI_API_KEY="replace-with-gemini-api-key"
GROQ_API_KEY="replace-with-groq-api-key"

# --- Company enrichment ---
# Google's Custom Search API is closed to new signups and shuts down
# 2027-01-01 — using Tavily instead (free tier, no card required).
TAVILY_API_KEY="replace-with-tavily-api-key"

# --- Storage ---
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# --- Cron auth (Vercel sets the Authorization header to this automatically) ---
CRON_SECRET="replace-with-openssl-rand-base64-32"

# --- Neo ID hashing ---
# Neo IDs are never stored in plaintext — only salted with this pepper and
# hashed one-way — so shortlist matching works without the app ever holding a
# real Neo ID. Keep this secret and stable (changing it invalidates existing
# hashes). Generate with `openssl rand -base64 32`.
NEO_ID_HASH_SECRET="replace-with-openssl-rand-base64-32"

# --- Storage reclamation (all optional; defaults shown) ---
# Attachments for a finished drive are deleted from blob storage once the
# company retires. Nothing else about a company is ever dropped.
# Days of silence after a RESULT mail before a drive counts as finished:
RETIRE_AFTER_RESULT_DAYS="30"
# Days of total silence before a drive that never announced a result is
# written off:
RETIRE_AFTER_IDLE_DAYS="120"
# Attachments processed per nightly run, so a backlog can't exceed the cron
# time limit:
RECLAIM_BATCH_SIZE="200"

# --- Ingestion cutoff (optional; default shown) ---
# Only mail received strictly after this instant is ingested. Stops the first
# Pub/Sub push from pulling in the entire label history — this batch's
# placements start June 2026, and older mail belongs to a different batch.
INGEST_AFTER="2026-05-31T23:59:59.999Z"
